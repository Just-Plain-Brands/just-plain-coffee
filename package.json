{
  "name": "just-plain-coffee",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "codegen": "turbo run codegen --filter=@just-plain-coffee/storefront",
    "dev": "turbo run dev --filter=@just-plain-coffee/storefront",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "preview": "turbo run preview --filter=@just-plain-coffee/storefront",
    "typecheck": "turbo run typecheck"
  },
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "devDependencies": {
    "turbo": "^2.10.7"
  }
}
