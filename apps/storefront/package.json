{
  "name": "@just-plain-coffee/storefront",
  "version": "2026.4.5",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm graphql:schema && shopify hydrogen build --codegen --no-lockfile-check",
    "codegen": "pnpm graphql:schema && shopify hydrogen codegen && react-router typegen",
    "dev": "pnpm graphql:schema && shopify hydrogen dev --codegen",
    "graphql:schema": "node ./scripts/generate-graphql-schemas.mjs",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "postinstall": "pnpm graphql:schema",
    "preview": "shopify hydrogen preview",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/caprasimo": "^5.3.0",
    "@shopify/hydrogen": "2026.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.16.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "^4.5.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@storybook/react-vite": "10.5.5",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "graphql-config": "^5.0.3",
    "shadcn": "^4.16.0",
    "storybook": "10.5.5",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.1"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  }
}
