{
  "extends": "../../tsconfig.base.json",
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../storefront/app/components/**/*.stories.ts",
    "../storefront/app/components/**/*.stories.tsx"
  ],
  "exclude": ["node_modules", "storybook-static"],
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "paths": {
      "~/*": ["../storefront/app/*"],
      "customer-accountapi.generated": [
        "../storefront/customer-accountapi.generated.d.ts"
      ],
      "storefrontapi.generated": ["../storefront/storefrontapi.generated.d.ts"]
    },
    "composite": false,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo"
  }
}
